{
  "name": "realheart",
  "version": "0.2.7",
  "description": "给她一个能记账的心情层：心情必须有来处，改动必须有账，她自己能停能查",
  "type": "module",
  "main": "index.mjs",
  "bin": {
    "realheart": "bin/realheart.mjs"
  },
  "files": [
    "index.mjs",
    "lib/",
    "bin/",
    "setup.mjs",
    "cordis.patch.yml",
    "runtime/*.py",
    "scripts/backup-before-switch.sh",
    "scripts/rollback.sh",
    "scripts/switch-to-package.sh",
    "scripts/uninstall.sh",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "realheart",
    "persona",
    "memory",
    "state"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sayasaikou/saya-dsh-realhuman.git"
  },
  "homepage": "https://github.com/sayasaikou/saya-dsh-realhuman#readme",
  "bugs": {
    "url": "https://github.com/sayasaikou/saya-dsh-realhuman/issues"
  },
  "license": "MIT"
}
